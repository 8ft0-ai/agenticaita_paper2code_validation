+from __future__ import annotations
+
+import csv
+import sqlite3
+import subprocess
+import sys
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+
+def create_market_db(path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    start = datetime(2026, 4, 6, tzinfo=timezone.utc)
+    rows = []
+    for symbol, base_price in (("BTC/USDT:USDT", 70000.0), ("ETH/USDT:USDT", 3000.0)):
+        for minute in range(3):
+            timestamp = start + timedelta(minutes=minute)
+            timestamp_ms = int(timestamp.timestamp() * 1000)
+            rows.append(
+                (
+                    "binanceusdm",
+                    symbol,
+                    "1m",
+                    timestamp_ms,
+                    timestamp.isoformat().replace("+00:00", "Z"),
+                    base_price + minute,
+                    base_price + minute + 2.0,
+                    base_price + minute - 1.0,
+                    base_price + minute + 0.5,
+                    100.0 + minute,
+                )
+            )
+    with sqlite3.connect(path) as conn:
+        conn.execute(
+            """
+            CREATE TABLE candles (
+                exchange_id TEXT NOT NULL,
+                symbol TEXT NOT NULL,
+                timeframe TEXT NOT NULL,
+                timestamp_ms INTEGER NOT NULL,
+                timestamp TEXT NOT NULL,
+                open REAL NOT NULL,
+                high REAL NOT NULL,
+                low REAL NOT NULL,
+                close REAL NOT NULL,
+                volume REAL NOT NULL
+            )
+            """
+        )
+        conn.executemany(
+            """
+            INSERT INTO candles (
+                exchange_id, symbol, timeframe, timestamp_ms, timestamp,
+                open, high, low, close, volume
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+            """,
+            rows,
+        )
+
+
+def test_real_data_workflow_exports_complete_symbols_without_fetch_or_replication(tmp_path: Path) -> None:
+    repo_root = Path(__file__).resolve().parents[2]
+    market_db = tmp_path / "market_data.sqlite"
+    replication_input = tmp_path / "replication_input_ohlcv.csv"
+    symbols_out = tmp_path / "complete_symbols.txt"
+    create_market_db(market_db)
+
+    result = subprocess.run(
+        [
+            sys.executable,
+            "scripts/run_real_data_replication.py",
+            "--skip-fetch",
+            "--skip-replication",
+            "--profile",
+            "baseline-15",
+            "--exchange",
+            "binanceusdm",
+            "--start",
+            "2026-04-06T00:00:00Z",
+            "--end",
+            "2026-04-06T00:02:00Z",
+            "--market-db",
+            str(market_db),
+            "--replication-input",
+            str(replication_input),
+            "--symbols-out",
+            str(symbols_out),
+        ],
+        cwd=repo_root,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+    assert "scripts/export_replication_input.py" in result.stdout
+    assert "wrote 6 rows across 2 selected symbols" in result.stdout
+    assert symbols_out.read_text(encoding="utf-8").splitlines() == ["BTC/USDT:USDT", "ETH/USDT:USDT"]
+
+    with replication_input.open(newline="", encoding="utf-8") as handle:
+        rows = list(csv.DictReader(handle))
+
+    assert len(rows) == 6
+    assert rows[0]["asset"] == "BTC"
+    assert rows[0]["source_symbol"] == "BTC/USDT:USDT"
+    assert {
+        "timestamp",
+        "asset",
+        "exchange_id",
+        "source_symbol",
+        "timeframe",
+        "open",
+        "high",
+        "low",
+        "close",
+        "volume",
+    }.issubset(rows[0])
