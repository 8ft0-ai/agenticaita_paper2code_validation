+def apply_llm_cli_overrides(cfg: dict, args: argparse.Namespace) -> None:
+    llm_cfg = cfg.setdefault("llm", {})
+    overrides = {
+        "llm_provider": "provider",
+        "model": "model",
+        "temperature": "temperature",
+        "max_tokens": "max_tokens",
+        "timeout": "timeout_seconds",
+        "base_url": "base_url",
+        "api_key_env": "api_key_env",
+        "audit_log": "audit_log_path",
+        "max_retries": "max_retries",
+        "retry_backoff": "retry_backoff_seconds",
+    }
+    for arg_name, config_key in overrides.items():
+        value = getattr(args, arg_name, None)
+        if value is not None:
+            llm_cfg[config_key] = value
+
+
+def load_prompt_overrides(prompt_dir: Path | None) -> dict[str, str]:
+    if prompt_dir is None:
+        return {}
+    templates = {
+        "analyst": prompt_dir / "analyst.txt",
+        "risk_manager": prompt_dir / "risk_manager.txt",
+    }
+    return {name: path.read_text(encoding="utf-8") for name, path in templates.items() if path.exists()}
+
+
+def configured_prompts(agent_cfg: dict, prompt_dir: Path | None) -> dict[str, str]:
+    llm_agent_cfg = agent_cfg.get("llm", {}) if isinstance(agent_cfg.get("llm"), dict) else {}
+    prompts = dict(llm_agent_cfg.get("prompts") or {})
+    prompts.update(load_prompt_overrides(prompt_dir))
+    return {key: value for key, value in prompts.items() if value}
+
+
+def llm_agent_config(agent_cfg: dict) -> dict:
+    value = agent_cfg.get("llm", {})
+    return value if isinstance(value, dict) else {}
+
