+def validate_ohlcv_input(ohlcv: pd.DataFrame, data_source: str) -> dict:
+    """Validate OHLCV input before running the replication harness."""
+    errors: list[str] = []
+    missing = missing_columns(ohlcv, REQUIRED_OHLCV_COLUMNS)
+    duplicate_count = 0
+
+    if ohlcv.empty:
+        errors.append("OHLCV input is empty")
+    if missing:
+        errors.append(f"OHLCV input missing required columns: {missing}")
+    if not missing and not ohlcv.empty:
+        duplicate_count = int(ohlcv.duplicated(subset=["timestamp", "asset"]).sum())
+        if duplicate_count:
+            errors.append(f"OHLCV input contains {duplicate_count} duplicate (timestamp, asset) rows")
+
+    if errors:
+        raise QualityCheckError("; ".join(errors))
+
+    return {
+        "status": "pass",
+        "data_source": data_source,
+        "rows": int(len(ohlcv)),
+        "columns_checked": list(REQUIRED_OHLCV_COLUMNS),
+        "duplicate_timestamp_asset_rows": duplicate_count,
+    }
+
+
+def validate_replication_outputs(
