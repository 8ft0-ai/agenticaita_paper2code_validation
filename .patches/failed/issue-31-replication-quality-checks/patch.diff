+) -> dict:
+    """Validate generated replication outputs before writing interpretive reports."""
+    errors: list[str] = []
+    warnings: list[str] = []
+
+    if real_data_run and pipeline_log.empty:
+        errors.append("pipeline_log is empty for real-data run")
+    if not pipeline_log.empty:
+        missing_log = missing_columns(pipeline_log, REQUIRED_PIPELINE_LOG_COLUMNS)
+        if missing_log:
+            errors.append(f"pipeline_log missing required columns: {missing_log}")
+    if trades.empty:
+        warnings.append("trades output is empty; no executed trades were produced")
+    else:
+        missing_trades = missing_columns(trades, REQUIRED_TRADES_COLUMNS)
+        if missing_trades:
+            errors.append(f"trades output missing required columns: {missing_trades}")
+
+    if errors:
+        raise QualityCheckError("; ".join(errors))
+
+    return {"status": "pass", "real_data_run": real_data_run, "warnings": warnings}
+
+
+def validate_report_written(path: Path) -> dict:
+    if not path.exists() or path.stat().st_size == 0:
+        raise QualityCheckError(f"replication report was not written: {path}")
+    return {"status": "pass", "path": str(path)}
