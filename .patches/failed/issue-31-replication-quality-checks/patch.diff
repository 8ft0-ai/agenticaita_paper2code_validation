@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+
+def test_validate_ohlcv_input_rejects_duplicate_timestamp_asset() -> None:
+    pd = pytest.importorskip("pandas")
+    from replicate import QualityCheckError, validate_ohlcv_input
+
+    frame = pd.DataFrame(
+        [
+            {"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "close": 100.0},
+            {"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "close": 101.0},
+        ]
+    )
+    frame["timestamp"] = pd.to_datetime(frame["timestamp"], utc=True)
+
+    with pytest.raises(QualityCheckError, match="duplicate"):
+        validate_ohlcv_input(frame, "input.csv")
+
+
+def test_validate_replication_outputs_rejects_empty_real_data_pipeline_log() -> None:
+    pd = pytest.importorskip("pandas")
+    from replicate import QualityCheckError, validate_replication_outputs
+
+    with pytest.raises(QualityCheckError, match="pipeline_log is empty"):
+        validate_replication_outputs(pd.DataFrame(), pd.DataFrame(), real_data_run=True)
+
+
+def test_validate_replication_outputs_warns_when_trades_empty() -> None:
+    pd = pytest.importorskip("pandas")
+    from replicate import validate_replication_outputs
+
+    pipeline_log = pd.DataFrame([{"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "event": "trigger"}])
+
+    result = validate_replication_outputs(pipeline_log, pd.DataFrame(), real_data_run=True)
+
+    assert result["status"] == "pass"
+    assert result["warnings"] == ["trades output is empty; no executed trades were produced"]
+
+
+def test_validate_replication_outputs_accepts_successful_real_data_style_outputs() -> None:
+    pd = pytest.importorskip("pandas")
+    from replicate import validate_ohlcv_input, validate_replication_outputs
+
+    ohlcv = pd.DataFrame([{"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "close": 100.0}])
+    pipeline_log = pd.DataFrame([{"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "event": "trigger"}])
+    trades = pd.DataFrame([{"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "signal": "long", "net_pnl_usd": 1.0}])
+
+    assert validate_ohlcv_input(ohlcv, "input.csv")["status"] == "pass"
+    assert validate_replication_outputs(pipeline_log, trades, real_data_run=True)["status"] == "pass"
+
+
+def test_replicate_cli_exits_clearly_for_duplicate_input(tmp_path: Path) -> None:
+    pd = pytest.importorskip("pandas")
+
+    replication_root = Path(__file__).resolve().parents[1]
+    input_csv = tmp_path / "duplicate_input.csv"
+    out_dir = tmp_path / "results"
+    pd.DataFrame(
+        [
+            {"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "close": 100.0},
+            {"timestamp": "2026-04-06T00:00:00Z", "asset": "BTC", "close": 101.0},
+        ]
+    ).to_csv(input_csv, index=False)
+
+    result = subprocess.run(
+        [sys.executable, "replicate.py", "--config", "config.yaml", "--input-csv", str(input_csv), "--out", str(out_dir)],
+        cwd=replication_root,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode != 0
+    assert "replication quality check failed" in result.stderr
+    assert "duplicate (timestamp, asset)" in result.stderr
