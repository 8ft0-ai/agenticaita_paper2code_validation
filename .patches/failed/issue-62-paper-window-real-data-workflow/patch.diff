+name: Paper Window Real Data Replication
+
+on:
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: "Data source mode: closest tries Hyperliquid first, then Binance USD-M fallback."
+        required: true
+        type: choice
+        default: closest
+        options:
+          - closest
+          - hyperliquid
+          - binanceusdm
+      start:
+        description: "Inclusive UTC start timestamp."
+        required: true
+        default: "2026-04-06T00:00:00Z"
+      end:
+        description: "Inclusive UTC end timestamp."
+        required: true
+        default: "2026-04-11T23:59:59Z"
+      symbol_limit:
+        description: "Baseline symbol count to export; 15 matches the paper-window reconstruction subset."
+        required: true
+        default: "15"
+      upload_replication_input:
+        description: "Upload exported replication_input_ohlcv.csv. Leave false unless the data file is needed for review."
+        required: true
+        type: boolean
+        default: false
+
+permissions:
+  contents: read
+
+jobs:
+  paper-window-real-data:
+    runs-on: ubuntu-latest
+    timeout-minutes: 360
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements.txt pandas PyYAML scipy tabulate
+
+      - name: Run closest paper-window public-data replication
+        id: realdata
+        shell: bash
+        run: |
+          set +e
+          MODE="${{ inputs.mode }}"
+          START="${{ inputs.start }}"
+          END="${{ inputs.end }}"
+          SYMBOL_LIMIT="${{ inputs.symbol_limit }}"
+          CHOSEN_EXCHANGE=""
+          FALLBACK_REASON=""
+          RUN_STATUS=1
+          QUALITY_STATUS=1
+
+          run_attempt() {
+            local exchange="$1"
+            local market_out="data/${exchange}_ohlcv_paper_window"
+            local replication_out="replication/results_real_${exchange}_paper_window"
+            echo "Attempting ${exchange} for ${START} to ${END}" | tee -a real_data_attempts.log
+            python scripts/run_real_data_replication.py \
+              --profile baseline-15 \
+              --exchange "${exchange}" \
+              --symbol-limit "${SYMBOL_LIMIT}" \
+              --start "${START}" \
+              --end "${END}" \
+              --market-out "${market_out}" \
+              --replication-out "${replication_out}" \
+              2>&1 | tee "run_${exchange}.log"
+            return "${PIPESTATUS[0]}"
+          }
+
+          if [ "${MODE}" = "hyperliquid" ]; then
+            run_attempt hyperliquid
+            RUN_STATUS=$?
+            [ "${RUN_STATUS}" -eq 0 ] && CHOSEN_EXCHANGE="hyperliquid"
+          elif [ "${MODE}" = "binanceusdm" ]; then
+            run_attempt binanceusdm
+            RUN_STATUS=$?
+            [ "${RUN_STATUS}" -eq 0 ] && CHOSEN_EXCHANGE="binanceusdm"
+          else
+            run_attempt hyperliquid
+            HYPERLIQUID_STATUS=$?
+            if [ "${HYPERLIQUID_STATUS}" -eq 0 ]; then
+              CHOSEN_EXCHANGE="hyperliquid"
+              RUN_STATUS=0
+            else
+              FALLBACK_REASON="Hyperliquid paper-window attempt did not produce complete exportable OHLCV coverage; using Binance USD-M public perpetual-futures fallback."
+              echo "${FALLBACK_REASON}" | tee -a real_data_attempts.log
+              run_attempt binanceusdm
+              RUN_STATUS=$?
+              [ "${RUN_STATUS}" -eq 0 ] && CHOSEN_EXCHANGE="binanceusdm"
+            fi
+          fi
+
+          if [ -n "${CHOSEN_EXCHANGE}" ]; then
+            MARKET_OUT="data/${CHOSEN_EXCHANGE}_ohlcv_paper_window"
+            REPLICATION_OUT="replication/results_real_${CHOSEN_EXCHANGE}_paper_window"
+            python scripts/check_replication_quality.py \
+              --input-csv "${MARKET_OUT}/replication_input_ohlcv.csv" \
+              --results-dir "${REPLICATION_OUT}" \
+              --real-data \
+              > "${REPLICATION_OUT}/quality_report.json" \
+              2> "${REPLICATION_OUT}/quality_report.stderr"
+            QUALITY_STATUS=$?
+
+            python scripts/build_run_manifest.py \
+              --run-dir "${MARKET_OUT}" \
+              --scenario market_data_coverage \
+              --commit-sha "${GITHUB_SHA}" \
+              --command "python scripts/run_real_data_replication.py --profile baseline-15 --exchange ${CHOSEN_EXCHANGE} --symbol-limit ${SYMBOL_LIMIT} --start ${START} --end ${END}" \
+              --out "${MARKET_OUT}/run_manifest.json" \
+              --base-dir .
+            python scripts/build_run_manifest.py \
+              --run-dir "${REPLICATION_OUT}" \
+              --scenario replication \
+              --commit-sha "${GITHUB_SHA}" \
+              --command "python scripts/run_real_data_replication.py --profile baseline-15 --exchange ${CHOSEN_EXCHANGE} --symbol-limit ${SYMBOL_LIMIT} --start ${START} --end ${END}" \
+              --out "${REPLICATION_OUT}/run_manifest.json" \
+              --base-dir .
+            python scripts/build_run_manifest.py \
+              --run-dir "${REPLICATION_OUT}" \
+              --scenario quality_check \
+              --quality-json "${REPLICATION_OUT}/quality_report.json" \
+              --commit-sha "${GITHUB_SHA}" \
+              --command "python scripts/check_replication_quality.py --input-csv ${MARKET_OUT}/replication_input_ohlcv.csv --results-dir ${REPLICATION_OUT} --real-data" \
+              --out "${REPLICATION_OUT}/quality_run_manifest.json" \
+              --base-dir .
+
+            python scripts/index_run_results.py \
+              --runs "${MARKET_OUT}" "${REPLICATION_OUT}" \
+              --out-jsonl results_index.jsonl \
+              --out-md results_index.md
+            python scripts/render_results_dashboard.py \
+              --index results_index.jsonl \
+              --out results_dashboard.html
+          fi
+
+          cat > run_selection.json <<JSON
+          {
+            "requested_mode": "${MODE}",
+            "chosen_exchange": "${CHOSEN_EXCHANGE}",
+            "start": "${START}",
+            "end": "${END}",
+            "timeframe": "1m",
+            "symbol_limit": "${SYMBOL_LIMIT}",
+            "run_status": ${RUN_STATUS},
+            "quality_status": ${QUALITY_STATUS},
+            "fallback_reason": "${FALLBACK_REASON}"
+          }
+          JSON
+
+          echo "chosen_exchange=${CHOSEN_EXCHANGE}" >> "$GITHUB_OUTPUT"
+          echo "run_status=${RUN_STATUS}" >> "$GITHUB_OUTPUT"
+          echo "quality_status=${QUALITY_STATUS}" >> "$GITHUB_OUTPUT"
+
+      - name: Prepare upload selection
+        shell: bash
+        run: |
+          if [ "${{ inputs.upload_replication_input }}" = "true" ] && [ -n "${{ steps.realdata.outputs.chosen_exchange }}" ]; then
+            chosen="${{ steps.realdata.outputs.chosen_exchange }}"
+            cp "data/${chosen}_ohlcv_paper_window/replication_input_ohlcv.csv" replication_input_ohlcv.csv
+          fi
+
+      - name: Upload paper-window real-data artefacts
+        id: upload-results
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: paper-window-real-data-${{ github.run_id }}
+          if-no-files-found: warn
+          path: |
+            run_selection.json
+            real_data_attempts.log
+            run_*.log
+            data/*_ohlcv_paper_window/manifest.json
+            data/*_ohlcv_paper_window/coverage_report.json
+            data/*_ohlcv_paper_window/coverage_report.md
+            data/*_ohlcv_paper_window/complete_symbols_*.txt
+            data/*_ohlcv_paper_window/run_manifest.json
+            replication/results_real_*_paper_window/run_manifest.json
+            replication/results_real_*_paper_window/quality_run_manifest.json
+            replication/results_real_*_paper_window/quality_report.json
+            replication/results_real_*_paper_window/quality_report.stderr
+            replication/results_real_*_paper_window/summary.json
+            replication/results_real_*_paper_window/replication_report.md
+            results_index.jsonl
+            results_index.md
+            results_dashboard.html
+            replication_input_ohlcv.csv
+
+      - name: Write real-data summary
+        if: always()
+        shell: bash
+        run: |
+          {
+            echo "# Paper-window real-data replication"
+            echo
+            echo "Requested mode: \`${{ inputs.mode }}\`"
+            echo "Chosen exchange: \`${{ steps.realdata.outputs.chosen_exchange }}\`"
+            echo "Window: \`${{ inputs.start }}\` to \`${{ inputs.end }}\`"
+            echo "Timeframe: \`1m\`"
+            echo "Symbol limit: \`${{ inputs.symbol_limit }}\`"
+            echo "Run status: \`${{ steps.realdata.outputs.run_status }}\`"
+            echo "Quality status: \`${{ steps.realdata.outputs.quality_status }}\`"
+            echo
+            echo "Uploaded artefact: [paper-window-real-data-${{ github.run_id }}](${{ steps.upload-results.outputs.artifact-url }})"
+            echo
+            echo "This is the closest public-data reconstruction available from the workflow: Hyperliquid is attempted first in closest mode because it matches the paper venue; Binance USD-M is used only when Hyperliquid OHLCV cannot support the paper-window run."
+            echo
+            if [ -f results_index.md ]; then
+              echo "## Results index"
+              echo
+              cat results_index.md
+            else
+              echo "No results index was generated. Check uploaded logs and run_selection.json."
+            fi
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Fail if real-data run failed
+        if: always()
+        shell: bash
+        run: |
+          if [ "${{ steps.realdata.outputs.run_status }}" != "0" ] || [ "${{ steps.realdata.outputs.quality_status }}" != "0" ]; then
+            echo "run_status=${{ steps.realdata.outputs.run_status }} quality_status=${{ steps.realdata.outputs.quality_status }}"
+            exit 1
+          fi
