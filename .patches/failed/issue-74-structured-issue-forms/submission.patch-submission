@@ -0,0 +1,75 @@
+name: Replication task
+description: Implement or improve functional or real-data replication workflow.
+title: "[Replication]: "
+labels:
+  - needs-triage
+  - area:replication
+body:
+  - type: markdown
+    attributes:
+      value: |
+        Use this form for replication harness, data reconstruction, and run-output quality improvements.
+  - type: textarea
+    id: goal
+    attributes:
+      label: Replication goal
+      description: What behaviour, run path, or paper mechanism should be replicated or improved?
+    validations:
+      required: true
+  - type: textarea
+    id: scope
+    attributes:
+      label: Scope
+      description: Keep this to one focused patch where possible.
+      placeholder: |
+        In scope:
+        - ...
+        Out of scope:
+        - ...
+    validations:
+      required: true
+  - type: dropdown
+    id: replication_type
+    attributes:
+      label: Replication type
+      options:
+        - functional replication
+        - public real-data reconstruction
+        - quality check or audit output
+        - documentation/runbook support
+    validations:
+      required: true
+  - type: textarea
+    id: expected_artifacts
+    attributes:
+      label: Expected artefacts
+      description: List generated outputs, and state whether they must remain local.
+      placeholder: |
+        Generated outputs:
+        Retention decision:
+    validations:
+      required: true
+  - type: textarea
+    id: files
+    attributes:
+      label: Likely files or directories
+      placeholder: replication/replicate.py, scripts/run_real_data_replication.py
+    validations:
+      required: false
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      placeholder: |
+        - The replication path runs or fails clearly.
+        - Output quality is checked before interpretation.
+        - Generated artefacts remain ignored unless curated.
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command
+      placeholder: |
+        python scripts/run_real_data_replication.py --skip-fetch --skip-replication ...
+    validations:
+      required: true
