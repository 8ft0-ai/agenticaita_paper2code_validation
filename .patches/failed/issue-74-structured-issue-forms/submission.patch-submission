diff --git a/.github/ISSUE_TEMPLATE/bug_report.yml b/.github/ISSUE_TEMPLATE/bug_report.yml
new file mode 100644
index 0000000..2ba896b
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/bug_report.yml
@@ -0,0 +1,62 @@
+name: Bug or defect
+description: Report a reproducible defect in repository code, scripts, workflows, or documentation.
+title: "[Bug]: "
+labels:
+  - needs-triage
+body:
+  - type: markdown
+    attributes:
+      value: |
+        Use this form for reproducible defects. Add `agent-ready` only after the scope, acceptance criteria, and validation path are clear.
+  - type: textarea
+    id: observed
+    attributes:
+      label: Observed behaviour
+      description: What happened?
+      placeholder: Describe the failure, error output, or incorrect behaviour.
+    validations:
+      required: true
+  - type: textarea
+    id: expected
+    attributes:
+      label: Expected behaviour
+      description: What should have happened?
+    validations:
+      required: true
+  - type: textarea
+    id: reproduction
+    attributes:
+      label: Reproduction steps
+      description: Provide the smallest command sequence or workflow path that reproduces the problem.
+      placeholder: |
+        1. Run ...
+        2. Observe ...
+    validations:
+      required: true
+  - type: input
+    id: suspected_area
+    attributes:
+      label: Suspected area
+      description: Suggested `area:*` label, file, directory, or subsystem.
+      placeholder: area:automation, scripts/fetch_hyperliquid_ohlcv.py
+    validations:
+      required: false
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      description: What must be true for this bug to be fixed?
+      placeholder: |
+        - The failure is reproduced by a test or documented command.
+        - The command succeeds or fails with a clearer error.
+        - No generated artefacts are committed.
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation
+      description: Which command should be run after the fix?
+      placeholder: pytest replication/tests/test_real_data_workflow.py
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/validation_task.yml b/.github/ISSUE_TEMPLATE/validation_task.yml
