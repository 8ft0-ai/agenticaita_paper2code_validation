+name: Automation or workflow task
+description: Add or improve scripts, GitHub Actions, broker workflows, or repository process automation.
+title: "[Automation]: "
+labels:
+  - needs-triage
+  - area:automation
+body:
+  - type: textarea
+    id: goal
+    attributes:
+      label: Automation goal
+      description: What should the automation do?
+    validations:
+      required: true
+  - type: textarea
+    id: trigger
+    attributes:
+      label: Trigger or entry point
+      description: When or how should it run?
+      placeholder: workflow_dispatch, push to main, issue_comment, CLI command
+    validations:
+      required: true
+  - type: textarea
+    id: permissions
+    attributes:
+      label: Permissions and secrets
+      description: List required GitHub permissions, tokens, secrets, or external credentials.
+      placeholder: No new secrets required, or WIKI_PUSH_TOKEN, PATCH_BOT_TOKEN, etc.
+    validations:
+      required: true
+  - type: textarea
+    id: failure_behaviour
+    attributes:
+      label: Failure behaviour
+      description: How should failures be reported or handled?
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      placeholder: |
+        - The workflow/script has a clear entry point.
+        - Required permissions are documented.
+        - Failure messages are actionable.
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command or check
+      placeholder: python -m py_compile scripts/example.py
+    validations:
+      required: true
