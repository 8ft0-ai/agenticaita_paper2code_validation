+name: Documentation task
+description: Add or improve repository documentation, Wiki staging pages, or runbooks.
+title: "[Docs]: "
+labels:
+  - needs-triage
+  - area:docs
+body:
+  - type: textarea
+    id: audience
+    attributes:
+      label: Audience
+      description: Who is the document for?
+      placeholder: maintainers, reviewers, future agents, technical readers
+    validations:
+      required: true
+  - type: textarea
+    id: goal
+    attributes:
+      label: Documentation goal
+      description: What should the reader understand or be able to do?
+    validations:
+      required: true
+  - type: input
+    id: target_location
+    attributes:
+      label: Target location
+      placeholder: docs/example.md or docs/wiki/Example.md
+    validations:
+      required: true
+  - type: textarea
+    id: source_material
+    attributes:
+      label: Source material
+      description: Link issues, PRs, files, reports, or external sources that should inform the document.
+    validations:
+      required: false
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      placeholder: |
+        - The document is linked from the relevant index or runbook.
+        - Limitations are explicit.
+        - No generated artefacts are committed.
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation
+      description: For docs-only changes, state the review/check performed.
+      placeholder: Documentation-only change; checked links and repository paths.
+    validations:
+      required: true
