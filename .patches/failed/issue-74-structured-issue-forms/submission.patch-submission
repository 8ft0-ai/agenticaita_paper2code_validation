+name: Validation task
+description: Validate a claim, metric, assumption, or reportable result.
+title: "[Validation]: "
+labels:
+  - needs-triage
+  - area:validation
+body:
+  - type: markdown
+    attributes:
+      value: |
+        Use this form for static audits, statistical checks, and real-data validation tasks.
+  - type: textarea
+    id: claim
+    attributes:
+      label: Claim or assumption
+      description: What claim, metric, or assumption should be validated?
+    validations:
+      required: true
+  - type: textarea
+    id: evidence
+    attributes:
+      label: Available evidence
+      description: Identify source files, paper sections, public data, or prior reports.
+      placeholder: |
+        - Paper section/table:
+        - Repository file:
+        - Public market-data source:
+    validations:
+      required: true
+  - type: dropdown
+    id: evidence_level
+    attributes:
+      label: Evidence level
+      description: Select the intended evidence level.
+      options:
+        - evidence:static-audit
+        - evidence:functional-replication
+        - evidence:empirical-replication
+    validations:
+      required: true
+  - type: dropdown
+    id: artifact_dependency
+    attributes:
+      label: Artifact dependency
+      options:
+        - artifact:none
+        - artifact:public-data
+        - artifact:author-artifacts-required
+    validations:
+      required: true
+  - type: textarea
+    id: method
+    attributes:
+      label: Proposed method
+      description: Describe the validation approach.
+      placeholder: Compute..., compare..., flag unsupported if...
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      placeholder: |
+        - The validation result is reproducible.
+        - Unsupported claims are explicitly marked.
+        - Any limitations are documented.
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command
+      placeholder: |
+        cd validation
+        python validate_claims.py --out results
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/replication_task.yml b/.github/ISSUE_TEMPLATE/replication_task.yml
