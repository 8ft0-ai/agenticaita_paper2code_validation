+def apply_llm_cli_overrides(cfg: dict, args: argparse.Namespace) -> dict:
+    """Apply optional CLI LLM overrides while preserving config defaults when absent."""
+
+    llm_cfg = cfg.setdefault("llm", {})
+    overrides = {
+        "provider": "provider",
+        "model": "model",
+        "temperature": "temperature",
+        "max_tokens": "max_tokens",
+        "timeout": "timeout_seconds",
+        "base_url": "base_url",
+        "api_key_env": "api_key_env",
+        "audit_log": "audit_log_path",
+        "max_retries": "max_retries",
+        "retry_backoff": "retry_backoff_seconds",
+    }
+    for arg_name, config_key in overrides.items():
+        value = getattr(args, arg_name, None)
+        if value is not None:
+            llm_cfg[config_key] = value
+    return cfg
+
+
+def configured_prompts(cfg: dict, prompt_dir: str | Path | None = None) -> dict[str, str]:
+    """Resolve LLM prompt templates from defaults, config, then optional files."""
+
+    llm_agents = cfg.get("agents", {}).get("llm", {}) if isinstance(cfg.get("agents", {}), dict) else {}
+    prompt_cfg = llm_agents.get("prompts", {}) if isinstance(llm_agents, dict) else {}
+    prompts = {
+        "analyst_system_prompt": str(prompt_cfg.get("analyst_system_prompt") or ANALYST_PROMPT),
+        "risk_system_prompt": str(prompt_cfg.get("risk_system_prompt") or RISK_PROMPT),
+    }
+    if prompt_dir:
+        directory = Path(prompt_dir)
+        for key, names in PROMPT_FILE_CANDIDATES.items():
+            for name in names:
+                candidate = directory / name
+                if candidate.is_file():
+                    prompts[key] = candidate.read_text(encoding="utf-8")
+                    break
+    return prompts
