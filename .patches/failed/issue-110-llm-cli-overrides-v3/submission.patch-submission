+from __future__ import annotations
+
+from pathlib import Path
+
+from replicate import apply_llm_cli_overrides, build_parser, configured_prompts, configured_volatility_regime
+
+
+def test_replicate_help_documents_llm_override_flags() -> None:
+    help_text = build_parser().format_help()
+    for flag in (
+        "--provider",
+        "--model",
+        "--temperature",
+        "--max-tokens",
+        "--timeout",
+        "--base-url",
+        "--api-key-env",
+        "--audit-log",
+        "--max-retries",
+        "--retry-backoff",
+        "--prompt-dir",
+    ):
+        assert flag in help_text
+
+
+def test_apply_llm_cli_overrides_preserves_config_defaults_when_absent() -> None:
+    cfg = {"llm": {"provider": "openrouter", "model": "from-config", "temperature": 0.2}}
+    args = build_parser().parse_args([])
+
+    apply_llm_cli_overrides(cfg, args)
+
+    assert cfg["llm"] == {"provider": "openrouter", "model": "from-config", "temperature": 0.2}
+
+
+def test_apply_llm_cli_overrides_updates_all_llm_parameters() -> None:
+    cfg = {"llm": {}}
+    args = build_parser().parse_args(
+        [
+            "--provider",
+            "openrouter",
+            "--model",
+            "qwen/custom",
+            "--temperature",
+            "0.4",
+            "--max-tokens",
+            "256",
+            "--timeout",
+            "10",
+            "--base-url",
+            "https://example.test/chat",
+            "--api-key-env",
+            "CUSTOM_KEY",
+            "--audit-log",
+            "logs/audit.jsonl",
+            "--max-retries",
+            "3",
+            "--retry-backoff",
+            "0.1",
+        ]
+    )
+
+    apply_llm_cli_overrides(cfg, args)
+
+    assert cfg["llm"] == {
+        "provider": "openrouter",
+        "model": "qwen/custom",
+        "temperature": 0.4,
+        "max_tokens": 256,
+        "timeout_seconds": 10.0,
+        "base_url": "https://example.test/chat",
+        "api_key_env": "CUSTOM_KEY",
+        "audit_log_path": "logs/audit.jsonl",
+        "max_retries": 3,
+        "retry_backoff_seconds": 0.1,
+    }
+
+
+def test_prompt_config_and_prompt_dir_override_defaults(tmp_path: Path) -> None:
+    cfg = {
+        "agents": {
+            "llm": {
+                "prompts": {
+                    "analyst_system_prompt": "configured analyst",
+                    "risk_system_prompt": "configured risk",
+                }
+            }
+        }
+    }
+    assert configured_prompts(cfg) == {
+        "analyst_system_prompt": "configured analyst",
+        "risk_system_prompt": "configured risk",
+    }
+
+    (tmp_path / "analyst_system_prompt.txt").write_text("file analyst", encoding="utf-8")
+    (tmp_path / "risk_system_prompt.txt").write_text("file risk", encoding="utf-8")
+
+    assert configured_prompts(cfg, tmp_path) == {
+        "analyst_system_prompt": "file analyst",
+        "risk_system_prompt": "file risk",
+    }
+
+
+def test_configured_volatility_regime_reads_agent_llm_config() -> None:
+    cfg = {
+        "agents": {
+            "llm": {
+                "volatility_regime": {
+                    "high_z_score": 5,
+                    "active_z_score": 4,
+                    "high_abs_return": 0.02,
+                    "active_abs_return": 0.01,
+                }
+            }
+        }
+    }
+
+    regime = configured_volatility_regime(cfg)
+
+    assert regime.high_z_score == 5
+    assert regime.active_z_score == 4
+    assert regime.high_abs_return == 0.02
+    assert regime.active_abs_return == 0.01
