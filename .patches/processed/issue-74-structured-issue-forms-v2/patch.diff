diff --git a/.github/ISSUE_TEMPLATE/automation_task.yml b/.github/ISSUE_TEMPLATE/automation_task.yml
new file mode 100644
index 0000000..708e7e6
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/automation_task.yml
@@ -0,0 +1,47 @@
+name: Automation or workflow task
+description: Add or improve scripts, GitHub Actions, broker workflows, or process automation.
+title: "[Automation]: "
+labels:
+  - needs-triage
+  - area:automation
+body:
+  - type: textarea
+    id: goal
+    attributes:
+      label: Automation goal
+      description: What should the automation do?
+    validations:
+      required: true
+  - type: textarea
+    id: trigger
+    attributes:
+      label: Trigger or entry point
+      description: When or how should it run?
+    validations:
+      required: true
+  - type: textarea
+    id: permissions
+    attributes:
+      label: Permissions and secrets
+      description: List required permissions, tokens, secrets, or external credentials.
+    validations:
+      required: true
+  - type: textarea
+    id: failure_behaviour
+    attributes:
+      label: Failure behaviour
+      description: How should failures be reported or handled?
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command or check
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/bug_report.yml b/.github/ISSUE_TEMPLATE/bug_report.yml
new file mode 100644
index 0000000..04449f2
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/bug_report.yml
@@ -0,0 +1,41 @@
+name: Bug or defect
+description: Report a reproducible defect in code, scripts, workflows, or documentation.
+title: "[Bug]: "
+labels:
+  - needs-triage
+body:
+  - type: textarea
+    id: observed
+    attributes:
+      label: Observed behaviour
+      description: What happened?
+    validations:
+      required: true
+  - type: textarea
+    id: expected
+    attributes:
+      label: Expected behaviour
+      description: What should have happened?
+    validations:
+      required: true
+  - type: textarea
+    id: reproduction
+    attributes:
+      label: Reproduction steps
+      description: Provide the smallest command sequence or workflow path that reproduces the problem.
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+      description: What must be true for this defect to be fixed?
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation
+      description: Which command or check should be run after the fix?
+    validations:
+      required: true
