diff --git a/.github/ISSUE_TEMPLATE/docs_task.yml b/.github/ISSUE_TEMPLATE/docs_task.yml
new file mode 100644
index 0000000..38cdbfb
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/docs_task.yml
@@ -0,0 +1,41 @@
+name: Documentation task
+description: Add or improve repository documentation, Wiki staging pages, or runbooks.
+title: "[Docs]: "
+labels:
+  - needs-triage
+  - area:docs
+body:
+  - type: textarea
+    id: audience
+    attributes:
+      label: Audience
+      description: Who is the document for?
+    validations:
+      required: true
+  - type: textarea
+    id: goal
+    attributes:
+      label: Documentation goal
+      description: What should the reader understand or be able to do?
+    validations:
+      required: true
+  - type: input
+    id: target_location
+    attributes:
+      label: Target location
+      placeholder: docs/example.md or docs/wiki/Example.md
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation
+      description: For docs-only changes, state the review or check performed.
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/replication_task.yml b/.github/ISSUE_TEMPLATE/replication_task.yml
new file mode 100644
index 0000000..c5eb433
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/replication_task.yml
@@ -0,0 +1,51 @@
+name: Replication task
+description: Implement or improve functional or real-data replication workflow.
+title: "[Replication]: "
+labels:
+  - needs-triage
+  - area:replication
+body:
+  - type: textarea
+    id: goal
+    attributes:
+      label: Replication goal
+      description: What behaviour, run path, or paper mechanism should be replicated or improved?
+    validations:
+      required: true
+  - type: textarea
+    id: scope
+    attributes:
+      label: Scope
+      description: Keep this to one focused patch where possible.
+    validations:
+      required: true
+  - type: dropdown
+    id: replication_type
+    attributes:
+      label: Replication type
+      options:
+        - functional replication
+        - public real-data reconstruction
+        - quality check or audit output
+        - documentation/runbook support
+    validations:
+      required: true
+  - type: textarea
+    id: expected_artifacts
+    attributes:
+      label: Expected artefacts
+      description: List generated outputs, and state whether they must remain local.
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/research_question.yml b/.github/ISSUE_TEMPLATE/research_question.yml
new file mode 100644
index 0000000..0779fa2
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/research_question.yml
@@ -0,0 +1,41 @@
+name: Research question
+description: Track an exploratory question before it becomes an implementation task.
+title: "[Research]: "
+labels:
+  - needs-triage
+  - area:research
+body:
+  - type: textarea
+    id: question
+    attributes:
+      label: Research question
+      description: What decision or uncertainty needs investigation?
+    validations:
+      required: true
+  - type: textarea
+    id: context
+    attributes:
+      label: Context
+      description: Why does this matter to validation, replication, data, docs, or automation?
+    validations:
+      required: true
+  - type: textarea
+    id: evidence_needed
+    attributes:
+      label: Evidence needed
+      description: What sources, data, experiments, or examples would answer the question?
+    validations:
+      required: true
+  - type: textarea
+    id: decision
+    attributes:
+      label: Decision enabled
+      description: What implementation or planning decision will this research unlock?
+    validations:
+      required: true
+  - type: textarea
+    id: done
+    attributes:
+      label: Done when
+    validations:
+      required: true
diff --git a/.github/ISSUE_TEMPLATE/validation_task.yml b/.github/ISSUE_TEMPLATE/validation_task.yml
new file mode 100644
index 0000000..d413794
--- /dev/null
+++ b/.github/ISSUE_TEMPLATE/validation_task.yml
@@ -0,0 +1,60 @@
+name: Validation task
+description: Validate a claim, metric, assumption, or reportable result.
+title: "[Validation]: "
+labels:
+  - needs-triage
+  - area:validation
+body:
+  - type: textarea
+    id: claim
+    attributes:
+      label: Claim or assumption
+      description: What claim, metric, or assumption should be validated?
+    validations:
+      required: true
+  - type: textarea
+    id: evidence
+    attributes:
+      label: Available evidence
+      description: Identify source files, paper sections, public data, or prior reports.
+    validations:
+      required: true
+  - type: dropdown
+    id: evidence_level
+    attributes:
+      label: Evidence level
+      options:
+        - evidence:static-audit
+        - evidence:functional-replication
+        - evidence:empirical-replication
+    validations:
+      required: true
+  - type: dropdown
+    id: artifact_dependency
+    attributes:
+      label: Artifact dependency
+      options:
+        - artifact:none
+        - artifact:public-data
+        - artifact:author-artifacts-required
+    validations:
+      required: true
+  - type: textarea
+    id: method
+    attributes:
+      label: Proposed method
+      description: Describe the validation approach.
+    validations:
+      required: true
+  - type: textarea
+    id: acceptance
+    attributes:
+      label: Acceptance criteria
+    validations:
+      required: true
+  - type: textarea
+    id: validation
+    attributes:
+      label: Validation command
+    validations:
+      required: true
