{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "autoupdate": "notify",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python -m json.tool *": "allow",
      "rm *": "deny",
      "git reset*": "deny",
      "git checkout --*": "deny",
      "git clean*": "deny",
      "git push*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
